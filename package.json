{
  "name": "cross-walkri-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for CROSS+WALKRI tooling infrastructure",
  "license": "CC0-1.0",
  "scripts": {
    "build": "pnpm -r build",
    "bundle": "packages/mcp-server/node_modules/.bin/esbuild packages/mcp-server/src/index.ts --bundle --platform=node --format=esm --outfile=server.mjs && packages/mcp-server/node_modules/.bin/esbuild packages/mcp-server/src/http.ts --bundle --platform=node --format=esm --outfile=server-http.mjs",
    "start": "node server-http.mjs",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --parallel exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node scripts/generate-primitives.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
